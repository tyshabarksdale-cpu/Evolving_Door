# Contact Form Integration
# Copy this file to .env and fill in your actual values

# Google Sheets API Configuration
# 1. Create a service account in Google Cloud Console
# 2. Download the JSON credentials file
# 3. Copy the email and private key from that file
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour\nPrivate\nKey\nHere\n-----END PRIVATE KEY-----\n"

# Google Sheet ID (from the URL: https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit)
GOOGLE_SHEET_ID=your-google-sheet-id-here

# Resend API Configuration
# 1. Sign up at https://resend.com
# 2. Get your API key from the dashboard
# 3. Verify your domain (or use their test domain for development)
RESEND_API_KEY=re_your_api_key_here

# Coach's Email Address (where form submissions will be sent)
COACH_EMAIL=janice@yourdomain.com

# Existing environment variables (keep these)
# Add any other .env variables you already have below
